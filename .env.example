# All optional. langlock needs no API key and makes no network calls.
# A byte-level BPE tokenizer.json (for example from Qwen2.5-0.5B-Instruct): used by `-m real` tests.
LANGLOCK_TOKENIZER_JSON=
# A local model directory (for example Qwen2.5-0.5B-Instruct): used by examples/real_hf_qwen.py and `-m real` tests.
LANGLOCK_MODEL_DIR=
